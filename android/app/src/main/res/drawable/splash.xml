<?xml version="1.0" encoding="utf-8"?>
<!-- White launch background with the app emblem centred at its intrinsic
     size. A single centred bitmap keeps the logo round on any screen shape,
     instead of stretching one splash image per density bucket. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
